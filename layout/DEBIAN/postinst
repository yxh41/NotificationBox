#!/bin/sh
# NotifyBox · v0.0.173
#
# 🔴🔴 v0.0.173：**这里不再自动重启 SpringBoard**。
#    用户明确要求「下次不用自动注销，我自己手动操作就行」——这是他的设备，
#    装完立刻黑屏一下再回来虽然"贴心"，但什么时候重启该由他说了算。
#    ⚠️ 代价必须讲清：tweak 的 dylib **只在 SpringBoard 重启时重新加载**。
#    装完不重启 ⇒ 盒子 App 是新的、SpringBoard 里跑的过滤逻辑还是旧的，
#    症状与「代码没改」完全同形（v0.0.168~171 连着四版就是栽在这上面）。
#    ⇒ 所以"手动"必须配一个**看得见的提示**：盒子 App 每次进主页都比
#      `.tweak_ctor` 里的版本号和自己这一份，不一致就在顶部挂一条字
#      「正在跑旧版，请重启一次」。不靠用户记，也不靠他真的会去看自检页。
#
# 🔴 这个脚本现在只做一件事：把数据目录的**属主和权限**摆正。
#    v0.0.157 的教训：0777 只写在 NBDataDir() 里，而 backboardd **从不调它**
#    ⇒ 真机目录一直是 755，「预防」在唯一那个 root 进程里是空的。
#    这里是唯一以 root 身份、在"装完那一刻"跑的代码，补得上。
#    写成功也要设 mode：落盘 mode 由 umask 决定，不 chmod 就等于把
#    「标记在不在」的判定权交给 umask（跨身份读不到 ≡ 没写）。
#
#    ⚠️ 这些都**不能替代** entitlement 白名单：白名单没生效时沙箱直接 EPERM，
#    Unix 权限再宽也白搭。这条只是把"Unix 那一层"先摆正，免得它伪装成白名单的错。

DATADIR=/var/mobile/Library/NotifyBox

if [ -d "$DATADIR" ]; then
    chown mobile:mobile "$DATADIR" 2>/dev/null || true
    chmod 0777 "$DATADIR" 2>/dev/null || true
    chmod 0666 "$DATADIR"/*.sqlite 2>/dev/null || true
    chmod 0666 "$DATADIR"/*.plist 2>/dev/null || true
    chmod 0666 "$DATADIR"/.tweak_ctor 2>/dev/null || true
    chmod 0666 "$DATADIR"/.tweak_ctor_root 2>/dev/null || true
fi

exit 0
