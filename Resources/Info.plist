<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>               <string>NotifyBox</string>
    <key>CFBundleDisplayName</key>        <string>消息盒子</string>
    <key>CFBundleIdentifier</key>         <string>com.yxh41.notifybox.app</string>
    <key>CFBundleVersion</key>            <string>0.0.65</string>
    <key>CFBundleShortVersionString</key> <string>0.0.65</string>
    <key>CFBundleExecutable</key>         <string>NotifyBoxApp</string>
    <key>CFBundlePackageType</key>        <string>APPL</string>
    <key>LSRequiresIPhoneOS</key>         <true/>
    <!-- v0.0.50：桌面图标。CFBundleIconFiles 里写**不带扩展名**的名字；
         SpringBoard 自己会找 AppIcon.png 并缩到各尺寸。满幅方图、圆角由系统加。 -->
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon</string>
            </array>
        </dict>
    </dict>
    <key>UILaunchStoryboardName</key>     <string></string>
    <key>UIMainStoryboardFile</key>       <string></string>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key> <false/>
    </dict>
</dict>
</plist>
